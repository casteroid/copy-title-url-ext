{
  "name": "copy-title-url-ext",
  "version": "0.0.3",
  "description": "An extension to copy the title and URL of the current page.",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "webextension-toolbox dev",
    "build": "webextension-toolbox build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "rm -rf dist packages && npm run build chrome && npm run build firefox",
    "release:plan": "node scripts/release/plan.ts",
    "lint:commits": "node scripts/release/lint-commits.ts"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@webextension-toolbox/webextension-toolbox": "^7.1.1",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
