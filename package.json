{
  "name": "copy-title-url-ext",
  "version": "0.0.3",
  "description": "An extension to copy the title and URL of the current page.",
  "private": true,
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs",
    "typecheck": "tsc --noEmit && tsc --noEmit -p app",
    "test": "vitest run",
    "package": "rm -rf dist packages && npm run build chrome && npm run build firefox",
    "release:plan": "node scripts/release/plan.ts",
    "lint:commits": "node scripts/release/lint-commits.ts"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
